        {
          "name": "Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// HTTP Response",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "pm.test(\"Content type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "// Response structure",
                  "const responseBody = pm.response.json();",
                  "pm.test(\"Response body has correct structure\", function () {",
                  "    pm.expect(responseBody).to.have.property(\"data\");",
                  "    pm.expect(responseBody).to.have.property(\"support\");",
                  "    pm.expect(responseBody).to.have.property(\"_meta\");",
                  "",
                  "    pm.expect(responseBody.data).to.have.property(\"id\");",
                  "    pm.expect(responseBody.data).to.have.property(\"email\");",
                  "    pm.expect(responseBody.data).to.have.property(\"first_name\");",
                  "    pm.expect(responseBody.data).to.have.property(\"last_name\");",
                  "    pm.expect(responseBody.data).to.have.property(\"avatar\");",
                  "",
                  "    pm.expect(responseBody.support).to.have.property(\"url\");",
                  "    pm.expect(responseBody.support).to.have.property(\"text\");",
                  "",
                  "    pm.expect(responseBody._meta).to.have.property(\"powered_by\");",
                  "    pm.expect(responseBody._meta).to.have.property(\"cta\");",
                  "    pm.expect(responseBody._meta.cta).to.have.property(\"label\");",
                  "    pm.expect(responseBody._meta.cta).to.have.property(\"url\");",
                  "",
                  "});",
                  "",
                  "// Data Validation",
                  "const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;  // Valid email format: text@text.domain",
                  "const urlRegex = /^https?:\\/\\/.+$/;               // Valid URL format: starts with http:// or https://",
                  "",
                  "pm.test(\"Data object validation\", function () {",
                  "    // 'id' data validation  ",
                  "    pm.expect(responseBody.data.id).to.equal(2);",
                  "    pm.expect(responseBody.data.id).to.be.a(\"number\");",
                  "",
                  "    // 'email' data validation  ",
                  "    pm.expect(responseBody.data.email).to.match(emailRegex);",
                  "",
                  "    // 'first_name' data validation  ",
                  "    pm.expect(responseBody.data.first_name).to.be.a(\"string\");",
                  "    pm.expect(responseBody.data.first_name.trim()).to.not.be.empty;",
                  "",
                  "    // 'last_name' data validation  ",
                  "    pm.expect(responseBody.data.last_name).to.be.a(\"string\");",
                  "    pm.expect(responseBody.data.last_name.trim()).to.not.be.empty;",
                  "",
                  "    // 'avatar' data validation",
                  "    pm.expect(responseBody.data.avatar).to.match(urlRegex);",
                  "});",
                  "",
                  "pm.test(\"'Support' object validation\", function () {",
                  "    // 'url' data validation  ",
                  "    pm.expect(responseBody.support.url).to.match(urlRegex);",
                  "    // 'text' data validation  ",
                  "    pm.expect(responseBody.support.text).to.be.a(\"string\");",
                  "    pm.expect(responseBody.support.text.trim()).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"'Meta' object validation\", function () {",
                  "    // 'powered_by' data validation  ",
                  "    pm.expect(responseBody._meta.powered_by).to.be.a(\"string\");",
                  "    pm.expect(responseBody._meta.powered_by.trim()).to.not.be.empty;",
                  "    // 'cta' data validation  ",
                  "    pm.expect(responseBody._meta.cta.label).to.be.a(\"string\");",
                  "    pm.expect(responseBody._meta.cta.label.trim()).to.not.be.empty;",
                  "    pm.expect(responseBody._meta.cta.url).to.match(urlRegex);",
                  "",
                  "});",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
