    {
      "name": "Users",
      "item": [
        {
          "name": "Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// HTTP Response\r",
                  "const responseBody = pm.response.json();\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "pm.test(\"Response time is less than 1000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "// Response structure\r",
                  "pm.test(\"Response body contains 'data' property\", function () {\r",
                  "    pm.expect(responseBody).to.have.property(\"data\");\r",
                  "});\r",
                  "pm.test(\"Data is an array of objects and is not empty\", function () {\r",
                  "    pm.expect(responseBody.data).to.be.an('array');\r",
                  "    pm.expect(responseBody.data).to.have.length.above(0);\r",
                  "});\r",
                  "// Validate each user object\r",
                  "pm.test(\"Each user has valid structure and data\", function () {\r",
                  "\r",
                  "    responseBody.data.forEach(function (user) {\r",
                  "\r",
                  "        pm.expect(user).to.have.property(\"id\");\r",
                  "        pm.expect(user).to.have.property(\"email\");\r",
                  "        pm.expect(user).to.have.property(\"first_name\");\r",
                  "        pm.expect(user).to.have.property(\"last_name\");\r",
                  "        pm.expect(user).to.have.property(\"avatar\");\r",
                  "\r",
                  "        pm.expect(user.id).to.be.a(\"number\");\r",
                  "\r",
                  "        pm.expect(user.email).to.be.a(\"string\");\r",
                  "        pm.expect(user.email).to.include(\"@\");\r",
                  "        pm.expect(user.email).to.not.be.empty;\r",
                  "\r",
                  "        pm.expect(user.first_name).to.be.a(\"string\");\r",
                  "        pm.expect(user.first_name).to.not.be.empty;\r",
                  "\r",
                  "        pm.expect(user.last_name).to.be.a(\"string\");\r",
                  "        pm.expect(user.last_name).to.not.be.empty;\r",
                  "\r",
                  "        pm.expect(user.avatar).to.be.a(\"string\");\r",
                  "        pm.expect(user.avatar).to.match(/^https?:\\/\\//);\r",
                  "        pm.expect(user.avatar).to.not.be.empty;\r",
                  "    });\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Pagination tests\", function () {\r",
                  "    pm.expect(responseBody.page).to.equal(2);\r",
                  "    pm.expect(responseBody.per_page).to.equal(6);\r",
                  "    pm.expect(responseBody.total).to.equal(12);\r",
                  "    pm.expect(responseBody.total_pages).to.equal(2);\r",
                  "});\r",
                  "pm.test(\"Returned users do not exceed per_page\", function () {\r",
                  "    if (responseBody.page < responseBody.total_pages) {\r",
                  "        pm.expect(responseBody.data.length).to.equal(responseBody.per_page);\r",
                  "    } else {\r",
                  "        pm.expect(responseBody.data.length).to.be.at.most(responseBody.per_page);\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
